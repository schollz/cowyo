# Set DATABASE_URL to use PostgreSQL. Leave it empty to use local SQLite.
DATABASE_URL=

# Used only when DATABASE_URL is empty.
SQLITE_PATH=cowyo2.sqlite3

# Optional but recommended in production. Sets the authoritative public origin
# for canonical URLs, social previews, returned paste URLs, robots.txt, and the
# sitemap. Use an origin only (for example, https://cowyo.com), without a path,
# query string, or fragment.
SITE_URL=

# Optional. Matching X-Cowyo-Admin-Key POSTs bypass rate, size, and page-lock
# limits. They may also publish through X-Cowyo-Published: true.
# Generate a long random value, for example with: openssl rand -hex 32
ADMIN_POST_KEY=

# Optional. Adds the Google tag to ordinary browser-rendered pages.
GOOGLE_TAG=

# Optional. Adds Google AdSense to every browser-rendered page, including
# permanent private pages. Use the ca-pub-XXXXXXXXXXXXXXXX client ID supplied
# by AdSense.
GOOGLE_ADSENSE=

# Optional. Adds the Umami tracker to every browser-rendered page when both
# values are set, including permanent private pages. UMAMI_URL must be an
# HTTP(S) origin without a path.
UMAMI_URL=
UMAMI_WEBSITE_ID=
